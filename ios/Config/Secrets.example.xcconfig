// Copy to Secrets.xcconfig (git-ignored) and fill in.
// The public Mapbox token (starts with pk.). Without it the app runs on a plain paper
// background with the route only, so the layout can still be checked.
MAPBOX_ACCESS_TOKEN = pk.your-public-token
// Your Apple team ID (Xcode > Settings > Accounts), needed to install on a phone.
DEVELOPMENT_TEAM = ABCDE12345
// Optional: a free Personal Team needs a bundle ID nobody else has registered.
// LOOP_BUNDLE_ID = com.yourname.loop
