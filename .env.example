# Copy to .env to override the local-development defaults. Never commit .env.
POSTGRES_USER=loop
POSTGRES_PASSWORD=loop
POSTGRES_DB=loop
DATABASE_URL=postgresql://loop:loop@localhost:5432/loop
# Phase 3 (decision 025): the Claude key and the Loop token stay in .env, never in git or the iPhone app.
# ANTHROPIC_API_KEY=
# LOOP_TOKEN=   # make one with: openssl rand -hex 24
# Whose runs may shape routes (full review 6.3): the reviewer's Apple Health prior (runner_prior) applies only to the
# install ids listed here, comma separated; empty means nobody. Never a person's name: the app's random install id.
# LOOP_PRIOR_INSTALL_IDS=
